<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (DECISIONS row 26). Nothing of this app goes to Google Drive backups or to a new phone by
     device-to-device transfer: the recordings (files/recordings) and the saved night state (shared
     preferences) are EEG, which identifies a person, and there is no setting worth restoring.
     Needed on top of allowBackup="false": on Android 12+ some makers still run device transfers then. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
