<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- The source has to see who calls it to read the caller's signing certificate (package visibility, Android 11+). -->
    <queries>
        <package android:name="io.github.utof.linkprobe.reader" />
        <package android:name="io.github.utof.linkprobe.readerwrong" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="Probe source">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Route 3: the fallback. Started for a result; hands the batch back, or refuses. -->
        <activity
            android:name=".BatchActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="io.github.utof.linkprobe.source.GET_BATCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Route 1: the read-only outbox. -->
        <provider
            android:name=".OutboxProvider"
            android:authorities="io.github.utof.linkprobe.source.outbox"
            android:exported="true" />

        <!-- Route 2: the same answer from a bound service. -->
        <service
            android:name=".OutboxService"
            android:exported="true" />

        <!-- Stands in for eeg's all-day recording service (state "fgs"). -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="link probe: stands in for a recording service" />
        </service>
    </application>
</manifest>
